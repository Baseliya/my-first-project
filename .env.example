# Ключ Anthropic API: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Токен бота від @BotFather у Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
# ID чатів членів сім'ї через кому (бот підкаже ваш ID після /start)
ALLOWED_CHAT_IDS=
# Часовий пояс і час щоденного звіту
TIMEZONE=Europe/Kyiv
DAILY_REPORT_TIME=21:00
# Валюта та частка доходу на інвестиції
CURRENCY=грн
INVEST_RATE=0.10
# Де зберігати базу
DB_PATH=data/budget.db
